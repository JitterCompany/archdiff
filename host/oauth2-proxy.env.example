# Copy to /etc/archdiff/oauth2-proxy.env on the VPS and fill in.
#
# GitHub OAuth app: GitHub > Settings > Developer settings > OAuth Apps > New
#   Homepage URL:               https://archdiff.jitter.nl
#   Authorization callback URL: https://archdiff.jitter.nl/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://archdiff.jitter.nl/oauth2/callback

# 32 random bytes: python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=

# Who may look: members of this GitHub org (optionally narrowed to teams, comma separated).
OAUTH2_PROXY_GITHUB_ORG=
# OAUTH2_PROXY_GITHUB_TEAM=
